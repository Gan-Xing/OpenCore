NODE_ENV=development
PORT=3000
API_GLOBAL_PREFIX=api
LOG_LEVEL=info
API_SWAGGER_ENABLED=true
API_SWAGGER_PUBLIC_ACK=false
CORS_ORIGINS=http://localhost:8000,http://localhost:5173,http://localhost:3000
AUTH_TOKEN_SECRET=change-me-change-me-change-me-32

# Scripted local smoke/deploy fixed ports.
OPENCORE_SMOKE_PORT=39173
OPENCORE_DEPLOY_API_PORT=39172
OPENCORE_DEPLOY_ADMIN_PORT=39174
OPENCORE_SMOKE_ADMIN_USERNAME=admin
OPENCORE_SMOKE_SEED=true
OPENCORE_DEPLOY_SEED=true

# PostgreSQL runtime. Use a local-only password in .env.opencore.local.
DATABASE_URL=postgresql://opencore_app:opencore_local_password@localhost:5432/opencore?schema=public

# Redis and BullMQ runtime isolation.
REDIS_URL=redis://localhost:6379/1
REDIS_KEY_PREFIX=opencore:
BULLMQ_QUEUE_PREFIX=opencore

# MinIO/S3-compatible runtime. Values here are placeholders only.
S3_ENDPOINT=http://localhost:9002
S3_REGION=us-east-1
S3_BUCKET=opencore
S3_PREFIX=runtime/
S3_ACCESS_KEY_ID=opencore-local-access-key
S3_SECRET_ACCESS_KEY=opencore-local-secret-key
S3_FORCE_PATH_STYLE=true

# Seed-only local value for R2. Never commit a real password.
BOOTSTRAP_ADMIN_PASSWORD=change-me-local-bootstrap-password

# GitHub OAuth account binding. Store real values only in .env.opencore.local.
OPENCORE_GITHUB_OAUTH_APP_ID=
OPENCORE_GITHUB_OAUTH_CLIENT_ID=
OPENCORE_GITHUB_OAUTH_CLIENT_SECRET=
OPENCORE_GITHUB_OAUTH_CALLBACK_URL=http://127.0.0.1:39172/api/integrations/oauth/callback/github
OPENCORE_OAUTH_CALLBACK_REDIRECT_URL=http://127.0.0.1:39174/personal/profile
