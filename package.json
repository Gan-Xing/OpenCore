{
  "name": "opencore",
  "version": "0.0.0",
  "private": true,
  "description": "OpenCore（开元）- AI Native 企业级全栈 Monorepo",
  "license": "UNLICENSED",
  "packageManager": "pnpm@10.12.1",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "build": "NX_DAEMON=false nx run-many -t build",
    "build:admin": "NX_DAEMON=false nx build admin",
    "build:api": "NX_DAEMON=false nx build api",
    "deploy:local": "bash tools/scripts/deploy-local-opencore.sh",
    "deploy:opencore": "bash tools/scripts/deploy-local-opencore.sh",
    "dev:admin": "NX_DAEMON=false nx serve admin",
    "dev:api": "NX_DAEMON=false nx serve api",
    "lint": "pnpm quality-docs:check && pnpm admin:i18n:check && pnpm api:error-codes:check && pnpm prisma:seed:check && pnpm smoke:helpers:check && pnpm smoke:typed:check && NX_DAEMON=false nx run-many -t lint",
    "openforge:check": "TS_NODE_PROJECT=tools/generator/tsconfig.json TS_NODE_COMPILER_OPTIONS='{\"moduleResolution\":\"node10\",\"module\":\"commonjs\",\"customConditions\":null}' node -r ts-node/register -r tsconfig-paths/register tools/generator/src/cli.ts check",
    "openforge:apply": "TS_NODE_PROJECT=tools/generator/tsconfig.json TS_NODE_COMPILER_OPTIONS='{\"moduleResolution\":\"node10\",\"module\":\"commonjs\",\"customConditions\":null}' node -r ts-node/register -r tsconfig-paths/register tools/generator/src/cli.ts apply",
    "openforge:diff": "TS_NODE_PROJECT=tools/generator/tsconfig.json TS_NODE_COMPILER_OPTIONS='{\"moduleResolution\":\"node10\",\"module\":\"commonjs\",\"customConditions\":null}' node -r ts-node/register -r tsconfig-paths/register tools/generator/src/cli.ts diff",
    "openforge:doctor": "TS_NODE_PROJECT=tools/generator/tsconfig.json TS_NODE_COMPILER_OPTIONS='{\"moduleResolution\":\"node10\",\"module\":\"commonjs\",\"customConditions\":null}' node -r ts-node/register -r tsconfig-paths/register tools/generator/src/cli.ts doctor",
    "openforge:manifest": "TS_NODE_PROJECT=tools/generator/tsconfig.json TS_NODE_COMPILER_OPTIONS='{\"moduleResolution\":\"node10\",\"module\":\"commonjs\",\"customConditions\":null}' node -r ts-node/register -r tsconfig-paths/register tools/generator/src/cli.ts manifest",
    "openforge:plan": "TS_NODE_PROJECT=tools/generator/tsconfig.json TS_NODE_COMPILER_OPTIONS='{\"moduleResolution\":\"node10\",\"module\":\"commonjs\",\"customConditions\":null}' node -r ts-node/register -r tsconfig-paths/register tools/generator/src/cli.ts plan",
    "openforge:rollback": "TS_NODE_PROJECT=tools/generator/tsconfig.json TS_NODE_COMPILER_OPTIONS='{\"moduleResolution\":\"node10\",\"module\":\"commonjs\",\"customConditions\":null}' node -r ts-node/register -r tsconfig-paths/register tools/generator/src/cli.ts rollback",
    "openforge:status": "TS_NODE_PROJECT=tools/generator/tsconfig.json TS_NODE_COMPILER_OPTIONS='{\"moduleResolution\":\"node10\",\"module\":\"commonjs\",\"customConditions\":null}' node -r ts-node/register -r tsconfig-paths/register tools/generator/src/cli.ts status",
    "openforge:test": "NX_DAEMON=false pnpm nx run-many -t test --projects=generator-core,openforge",
    "openforge:gate": "pnpm openforge:status && pnpm openforge:doctor && pnpm openforge:check -- --schema tools/generator/examples/core.dict.v1.schema.json && pnpm openforge:diff -- --schema tools/generator/examples/core.dict.v1.schema.json --format json",
    "openapi:check": "TS_NODE_PROJECT=apps/api/tsconfig.app.json TS_NODE_COMPILER_OPTIONS='{\"moduleResolution\":\"node10\",\"module\":\"commonjs\",\"customConditions\":null}' node -r ts-node/register -r tsconfig-paths/register apps/api/src/platform/openapi/check-openapi-drift.ts",
    "openapi:export": "TS_NODE_PROJECT=apps/api/tsconfig.app.json TS_NODE_COMPILER_OPTIONS='{\"moduleResolution\":\"node10\",\"module\":\"commonjs\",\"customConditions\":null}' node -r ts-node/register -r tsconfig-paths/register apps/api/src/platform/openapi/export-openapi.ts",
    "openapi:registry-tags:check": "TS_NODE_PROJECT=apps/api/tsconfig.app.json TS_NODE_COMPILER_OPTIONS='{\"moduleResolution\":\"node10\",\"module\":\"commonjs\",\"customConditions\":null}' node -r ts-node/register -r tsconfig-paths/register apps/api/src/platform/openapi/check-registry-tags.ts",
    "scripts:ts": "TS_NODE_PROJECT=tools/scripts/tsconfig.json TS_NODE_COMPILER_OPTIONS='{\"moduleResolution\":\"node10\",\"module\":\"commonjs\",\"customConditions\":null}' node -r ts-node/register -r tsconfig-paths/register",
    "prisma:generate": "prisma generate --schema prisma/schema.prisma && pnpm scripts:ts tools/scripts/sync-prisma-client-instances.ts",
    "prisma:migrate": "prisma migrate deploy --schema prisma/schema.prisma",
    "prisma:seed": "TS_NODE_PROJECT=tsconfig.base.json TS_NODE_COMPILER_OPTIONS='{\"moduleResolution\":\"node10\",\"module\":\"commonjs\",\"customConditions\":null}' node -r ts-node/register -r tsconfig-paths/register prisma/seed.ts",
    "prisma:seed:check": "tsc --noEmit -p tsconfig.prisma-seed.json",
    "prisma:studio": "prisma studio --schema prisma/schema.prisma",
    "prisma:validate": "prisma validate --schema prisma/schema.prisma",
    "quality-docs:check": "pnpm scripts:ts tools/scripts/check-quality-doc-noise.ts",
    "admin:i18n:check": "pnpm scripts:ts tools/scripts/check-admin-i18n.ts",
    "api:error-codes:check": "pnpm scripts:ts tools/scripts/check-api-error-codes.ts",
    "release:gate": "bash tools/scripts/release-readiness-gate.sh",
    "registry:admin-routes:check": "TS_NODE_PROJECT=tsconfig.base.json TS_NODE_COMPILER_OPTIONS='{\"moduleResolution\":\"node10\",\"module\":\"commonjs\",\"customConditions\":null}' node -r ts-node/register -r tsconfig-paths/register tools/scripts/check-admin-route-access.ts",
    "sdk:check": "pnpm scripts:ts tools/scripts/check-sdk-generate.ts",
    "sdk:generate": "pnpm scripts:ts tools/scripts/check-sdk-generate.ts",
    "smoke:api:local": "bash tools/scripts/run-local-api-smoke.sh",
    "smoke:admin-error-ui": "pnpm scripts:ts tools/scripts/run-typed-smoke.ts tools/smoke/smoke-admin-error-ui.ts",
    "smoke:error-contract": "pnpm scripts:ts tools/scripts/run-typed-smoke.ts tools/smoke/smoke-error-contract.ts",
    "smoke:helpers:check": "pnpm scripts:ts tools/scripts/check-smoke-helper-adoption.ts",
    "smoke:typed:check": "tsc --noEmit -p tools/smoke/tsconfig.json",
    "smoke:core-audit-log": "pnpm scripts:ts tools/scripts/run-typed-smoke.ts tools/smoke/smoke-core-audit-log.ts",
    "smoke:core-config": "pnpm scripts:ts tools/scripts/run-typed-smoke.ts tools/smoke/smoke-core-config.ts",
    "smoke:core-dict": "pnpm scripts:ts tools/scripts/run-typed-smoke.ts tools/smoke/smoke-core-dict.ts",
    "smoke:core-dept": "pnpm scripts:ts tools/scripts/run-typed-smoke.ts tools/smoke/smoke-core-dept.ts",
    "smoke:core-file": "pnpm scripts:ts tools/scripts/run-typed-smoke.ts tools/smoke/smoke-core-file.ts",
    "smoke:core-login-log": "pnpm scripts:ts tools/scripts/run-typed-smoke.ts tools/smoke/smoke-core-login-log.ts",
    "smoke:core-menu": "pnpm scripts:ts tools/scripts/run-typed-smoke.ts tools/smoke/smoke-core-menu.ts",
    "smoke:core-permission": "pnpm scripts:ts tools/scripts/run-typed-smoke.ts tools/smoke/smoke-core-permission.ts",
    "smoke:core-collaboration-messages": "pnpm scripts:ts tools/scripts/run-typed-smoke.ts tools/smoke/smoke-core-collaboration-messages.ts",
    "smoke:core-collaboration-notices": "pnpm scripts:ts tools/scripts/run-typed-smoke.ts tools/smoke/smoke-core-collaboration-notices.ts",
    "smoke:core-collaboration-todos": "pnpm scripts:ts tools/scripts/run-typed-smoke.ts tools/smoke/smoke-core-collaboration-todos.ts",
    "smoke:core-collaboration-approvals": "pnpm scripts:ts tools/scripts/run-typed-smoke.ts tools/smoke/smoke-core-collaboration-approvals.ts",
    "smoke:core-monitor-jobs": "pnpm scripts:ts tools/scripts/run-typed-smoke.ts tools/smoke/smoke-core-monitor-jobs.ts",
    "smoke:monitor-status": "pnpm scripts:ts tools/scripts/run-typed-smoke.ts tools/smoke/smoke-monitor-status.ts",
    "smoke:core-notice": "pnpm scripts:ts tools/scripts/run-typed-smoke.ts tools/smoke/smoke-core-notice.ts",
    "smoke:integration-designs": "pnpm scripts:ts tools/scripts/run-typed-smoke.ts tools/smoke/smoke-integration-designs.ts",
    "smoke:integration-health": "pnpm scripts:ts tools/scripts/run-typed-smoke.ts tools/smoke/smoke-integration-health.ts",
    "smoke:integration-oauth-tokens": "pnpm scripts:ts tools/scripts/run-typed-smoke.ts tools/smoke/smoke-integration-oauth-tokens.ts",
    "smoke:core-online-user": "pnpm scripts:ts tools/scripts/run-typed-smoke.ts tools/smoke/smoke-core-online-user.ts",
    "smoke:core-post": "pnpm scripts:ts tools/scripts/run-typed-smoke.ts tools/smoke/smoke-core-post.ts",
    "smoke:core-role": "pnpm scripts:ts tools/scripts/run-typed-smoke.ts tools/smoke/smoke-core-role.ts",
    "smoke:core-user": "pnpm scripts:ts tools/scripts/run-typed-smoke.ts tools/smoke/smoke-core-user.ts",
    "smoke:tool-area": "pnpm scripts:ts tools/scripts/run-typed-smoke.ts tools/smoke/smoke-tool-area.ts",
    "smoke:tool-openforge": "pnpm scripts:ts tools/scripts/run-typed-smoke.ts tools/smoke/smoke-tool-openforge.ts",
    "test": "NX_DAEMON=false nx run-many -t test",
    "test:admin": "NX_DAEMON=false nx test admin",
    "test:api": "NX_DAEMON=false nx test api",
    "typecheck": "NX_DAEMON=false nx run-many -t typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "guard:admin-live-only": "pnpm scripts:ts tools/scripts/admin-fallback-closure-guard.ts",
    "guard:admin-fallback-closure": "pnpm scripts:ts tools/scripts/admin-fallback-closure-guard.ts --manifest tools/guards/system-admin-live-only.guard.json",
    "nx": "NX_DAEMON=false nx"
  },
  "devDependencies": {
    "@eslint/js": "^9.8.0",
    "@nestjs/cli": "^11.0.23",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.0",
    "@nx/eslint": "21.6.11",
    "@nx/eslint-plugin": "21.6.11",
    "@nx/jest": "21.6.11",
    "@nx/js": "21.6.11",
    "@nx/nest": "21.6.11",
    "@nx/node": "21.6.11",
    "@nx/react": "^21.0.0",
    "@nx/web": "21.6.11",
    "@nx/webpack": "21.6.11",
    "@nx/workspace": "^21.0.0",
    "@swc-node/register": "~1.9.1",
    "@swc/core": "~1.15.41",
    "@swc/helpers": "~0.5.11",
    "@types/jest": "^30.0.0",
    "@types/node": "20.19.9",
    "@types/nodemailer": "^8.0.1",
    "buffer": "6.0.3",
    "eslint": "^9.8.0",
    "eslint-config-prettier": "^10.0.0",
    "jest": "^30.0.2",
    "jest-environment-node": "^30.0.2",
    "jest-util": "^30.0.2",
    "nx": "^21.0.0",
    "prettier": "^3.5.0",
    "prettier-plugin-organize-imports": "^4.3.0",
    "prettier-plugin-packagejson": "^3.0.2",
    "prettier-plugin-prisma": "^5.0.0",
    "prisma": "^7.8.0",
    "process": "0.11.10",
    "ts-jest": "^29.4.0",
    "ts-node": "10.9.1",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.40.0",
    "webpack-cli": "^5.1.4"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/swagger": "^11.4.4",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "bullmq": "^5.78.0",
    "ioredis": "^5.11.1",
    "minio": "^8.0.7",
    "nodemailer": "^8.0.11",
    "pg": "^8.21.0",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.8.0",
    "swagger-ui-express": "^5.0.1",
    "tslib": "^2.3.0"
  }
}
