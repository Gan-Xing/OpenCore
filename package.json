  "scripts": {
    "build": "NX_DAEMON=false nx run-many -t build",
    "build:admin": "NX_DAEMON=false nx build admin",
    "build:api": "NX_DAEMON=false nx build api",
    "deploy:local": "bash tools/scripts/deploy-local-opencore.sh",
    "deploy:opencore": "bash tools/scripts/deploy-local-opencore.sh",
    "dev:admin": "NX_DAEMON=false nx serve admin",
    "dev:api": "NX_DAEMON=false nx serve api",
    "lint": "pnpm quality-docs:check && pnpm admin:i18n:check && pnpm api:error-codes:check && pnpm prisma:seed:check && pnpm smoke:helpers:check && pnpm smoke:typed:check && NX_DAEMON=false nx run-many -t lint",
    "openforge:check": "TS_NODE_PROJECT=tools/generator/tsconfig.json TS_NODE_COMPILER_OPTIONS='{\"moduleResolution\":\"node10\",\"module\":\"commonjs\",\"customConditions\":null}' node -r ts-node/register -r tsconfig-paths/register tools/generator/src/cli.ts check",
    "openforge:apply": "TS_NODE_PROJECT=tools/generator/tsconfig.json TS_NODE_COMPILER_OPTIONS='{\"moduleResolution\":\"node10\",\"module\":\"commonjs\",\"customConditions\":null}' node -r ts-node/register -r tsconfig-paths/register tools/generator/src/cli.ts apply",
    "openforge:diff": "TS_NODE_PROJECT=tools/generator/tsconfig.json TS_NODE_COMPILER_OPTIONS='{\"moduleResolution\":\"node10\",\"module\":\"commonjs\",\"customConditions\":null}' node -r ts-node/register -r tsconfig-paths/register tools/generator/src/cli.ts diff",
    "openforge:doctor": "TS_NODE_PROJECT=tools/generator/tsconfig.json TS_NODE_COMPILER_OPTIONS='{\"moduleResolution\":\"node10\",\"module\":\"commonjs\",\"customConditions\":null}' node -r ts-node/register -r tsconfig-paths/register tools/generator/src/cli.ts doctor",
    "openforge:manifest": "TS_NODE_PROJECT=tools/generator/tsconfig.json TS_NODE_COMPILER_OPTIONS='{\"moduleResolution\":\"node10\",\"module\":\"commonjs\",\"customConditions\":null}' node -r ts-node/register -r tsconfig-paths/register tools/generator/src/cli.ts manifest",
    "openforge:plan": "TS_NODE_PROJECT=tools/generator/tsconfig.json TS_NODE_COMPILER_OPTIONS='{\"moduleResolution\":\"node10\",\"module\":\"commonjs\",\"customConditions\":null}' node -r ts-node/register -r tsconfig-paths/register tools/generator/src/cli.ts plan",
    "openforge:rollback": "TS_NODE_PROJECT=tools/generator/tsconfig.json TS_NODE_COMPILER_OPTIONS='{\"moduleResolution\":\"node10\",\"module\":\"commonjs\",\"customConditions\":null}' node -r ts-node/register -r tsconfig-paths/register tools/generator/src/cli.ts rollback",
    "openforge:status": "TS_NODE_PROJECT=tools/generator/tsconfig.json TS_NODE_COMPILER_OPTIONS='{\"moduleResolution\":\"node10\",\"module\":\"commonjs\",\"customConditions\":null}' node -r ts-node/register -r tsconfig-paths/register tools/generator/src/cli.ts status",
    "openforge:test": "NX_DAEMON=false pnpm nx run-many -t test --projects=generator-core,openforge",
    "openforge:gate": "pnpm openforge:status && pnpm openforge:doctor && pnpm openforge:check -- --schema tools/generator/examples/core.dict.v1.schema.json && pnpm openforge:diff -- --schema tools/generator/examples/core.dict.v1.schema.json --format json",
    "openapi:check": "TS_NODE_PROJECT=apps/api/tsconfig.app.json TS_NODE_COMPILER_OPTIONS='{\"moduleResolution\":\"node10\",\"module\":\"commonjs\",\"customConditions\":null}' node -r ts-node/register -r tsconfig-paths/register apps/api/src/platform/openapi/check-openapi-drift.ts",
    "openapi:export": "TS_NODE_PROJECT=apps/api/tsconfig.app.json TS_NODE_COMPILER_OPTIONS='{\"moduleResolution\":\"node10\",\"module\":\"commonjs\",\"customConditions\":null}' node -r ts-node/register -r tsconfig-paths/register apps/api/src/platform/openapi/export-openapi.ts",
    "openapi:registry-tags:check": "TS_NODE_PROJECT=apps/api/tsconfig.app.json TS_NODE_COMPILER_OPTIONS='{\"moduleResolution\":\"node10\",\"module\":\"commonjs\",\"customConditions\":null}' node -r ts-node/register -r tsconfig-paths/register apps/api/src/platform/openapi/check-registry-tags.ts",
