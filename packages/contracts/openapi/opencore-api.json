  "paths": {
    "/health/live": {
      "get": {
        "operationId": "HealthController_live",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Process liveness probe.",
            "content": {
              "application/json": {
                "schema": {
                  "example": {
                    "status": "ok",
                    "service": "opencore-api",
                    "version": "0.0.0",
                    "timestamp": "2026-06-10T00:00:00.000Z",
                    "uptimeSeconds": 1,
                    "checks": [
                      { "name": "process", "status": "ok", "critical": true }
                    ]
                  }
                }
              }
            }
          }
        },
        "tags": ["Health"]
      }
    },
    "/health/ready": {
