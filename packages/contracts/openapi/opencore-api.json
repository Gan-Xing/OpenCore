  "info": {
    "title": "OpenCore API",
    "description": "OpenCore API contract",
    "version": "0.0.0",
    "contact": {}
  },
  "tags": [],
  "servers": [{ "url": "/" }],
  "components": {
    "schemas": {
      "LoginRequestDto": {
        "type": "object",
        "properties": {
          "username": { "type": "string", "example": "admin" },
          "password": { "type": "string", "example": "admin123" }
        },
        "required": ["username", "password"]
      },
      "AuthenticatedUserDto": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "username": { "type": "string" },
          "displayName": { "type": "string" },
          "roleCodes": { "type": "array", "items": { "type": "string" } },
          "permissionCodes": { "type": "array", "items": { "type": "string" } }
        },
        "required": [
          "id",
          "username",
          "displayName",
          "roleCodes",
          "permissionCodes"
        ]
      },
      "LoginResponseDto": {
        "type": "object",
        "properties": {
          "accessToken": { "type": "string" },
          "tokenType": { "type": "string", "example": "Bearer" },
          "expiresInSeconds": { "type": "number" },
          "user": { "$ref": "#/components/schemas/AuthenticatedUserDto" }
        },
        "required": ["accessToken", "tokenType", "expiresInSeconds", "user"]
      },
      "UserSummaryDto": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "username": { "type": "string" },
          "displayName": { "type": "string" },
          "roleCodes": { "type": "array", "items": { "type": "string" } },
          "enabled": { "type": "boolean" }
        },
        "required": ["id", "username", "displayName", "roleCodes", "enabled"]
      },
      "RoleSummaryDto": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "code": { "type": "string" },
          "name": { "type": "string" },
          "permissionCodes": { "type": "array", "items": { "type": "string" } },
          "system": { "type": "boolean" }
        },
        "required": ["id", "code", "name", "permissionCodes", "system"]
      },
      "PermissionSummaryDto": {
        "type": "object",
        "properties": {
          "code": { "type": "string" },
          "title": { "type": "string" },
          "stage": { "type": "string" },
          "dangerous": { "type": "boolean" }
        },
        "required": ["code", "title", "stage", "dangerous"]
      },
      "MenuSummaryDto": {
        "type": "object",
        "properties": {
          "key": { "type": "string" },
          "title": { "type": "string" },
          "path": { "type": "string" },
          "permissionCode": { "type": "string" },
          "stage": { "type": "string" },
          "order": { "type": "number" }
        },
        "required": ["key", "title", "path", "stage", "order"]
      },
      "Object": { "type": "object", "properties": {} },
      "DictItemDto": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "label": { "type": "string" },
          "value": { "type": "string" },
          "sort": { "type": "number" },
          "enabled": { "type": "boolean" }
        },
        "required": ["id", "label", "value", "sort", "enabled"]
      },
      "DictTypeDto": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "code": { "type": "string" },
          "name": { "type": "string" },
          "description": { "type": "string" },
          "enabled": { "type": "boolean" },
          "items": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/DictItemDto" }
          }
        },
        "required": ["id", "code", "name", "enabled", "items"]
      },
      "DictTypePageDto": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/DictTypeDto" }
          },
          "page": { "type": "number" },
          "pageSize": { "type": "number" },
          "total": { "type": "number" },
          "totalPages": { "type": "number" }
        },
        "required": ["items", "page", "pageSize", "total", "totalPages"]
      },
      "ExportPreviewDto": {
        "type": "object",
        "properties": {
          "filename": { "type": "string" },
          "scope": { "type": "string", "example": "current-page" },
          "columns": { "type": "array", "items": { "type": "string" } },
          "rowCount": { "type": "number" },
          "generatedAt": { "type": "string" }
        },
        "required": ["filename", "scope", "columns", "rowCount", "generatedAt"]
      },
      "CreateDictTypeDto": {
        "type": "object",
        "properties": {
          "code": { "type": "string", "example": "system.status" },
          "name": { "type": "string", "example": "System Status" },
          "description": { "type": "string" },
          "enabled": { "type": "boolean", "default": true },
          "items": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/DictItemDto" }
          }
        },
        "required": ["code", "name"]
      },
      "UpdateDictTypeDto": {
        "type": "object",
        "properties": {
          "name": { "type": "string" },
