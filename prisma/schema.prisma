generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                  String                    @id @default(cuid())
  username            String                    @unique
  displayName         String
  mobile              String?
  email               String?
  gender              String?
  remark              String?
  passwordHash        String
  enabled             Boolean                   @default(true)
  forcePasswordChange Boolean                   @default(false)
  avatarUrl           String?
  avatarStorageKey    String?                   @unique
  avatarMimeType      String?
  avatarSizeBytes     Int?
  avatarUpdatedAt     DateTime?
  deptId              String?
  dept                SystemDept?               @relation(fields: [deptId], references: [id], onDelete: SetNull)
  roles               UserRole[]
  posts               UserPost[]
  tenantMemberships   TenantMembership[]        @relation("TenantMembershipUser")
  invitedMemberships  TenantMembership[]        @relation("TenantMembershipInvitedBy")
  createdTenants      Tenant[]                  @relation("TenantCreatedBy")
  platformRoles       UserPlatformRole[]
  noticeReads         SystemNoticeReadReceipt[]
  noticeDeliveries    SystemNoticeDelivery[]
  createdAt           DateTime                  @default(now())
  updatedAt           DateTime                  @updatedAt

  @@unique([mobile])
  @@unique([email])
  @@index([deptId])
}

model TenantPlan {
  id        String             @id @default(cuid())
  code      String             @unique
  name      String
  enabled   Boolean            @default(true)
  limits    Json               @default("{}")
  remark    String?
  modules   TenantPlanModule[]
  tenants   Tenant[]
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
}

model TenantPlanModule {
  planId     String
  moduleCode String
  plan       TenantPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@id([planId, moduleCode])
  @@index([moduleCode])
}

model Tenant {
  id                     String                             @id @default(cuid())
  code                   String                             @unique
  slug                   String                             @unique
  name                   String
  status                 String                             @default("active")
  planId                 String?
  plan                   TenantPlan?                        @relation(fields: [planId], references: [id], onDelete: SetNull)
  contactName            String?
  contactMobile          String?
  accountLimit           Int?
  expiresAt              DateTime?
  createdByUserId        String?
  createdBy              User?                              @relation("TenantCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  memberships            TenantMembership[]
  membershipRoles        TenantMembershipRole[]
  membershipPosts        TenantMembershipPost[]
  roles                  Role[]
  systemConfigs          SystemConfig[]
  dictTypes              DictType[]
  depts                  SystemDept[]
  posts                  SystemPost[]
  fileAssets             FileAsset[]
  systemNotices          SystemNotice[]
  noticeTemplates        SystemNoticeTemplate[]
  noticeReceipts         SystemNoticeReadReceipt[]
  noticeDeliveries       SystemNoticeDelivery[]
  schedulerJobs          JobDefinition[]
  schedulerRuns          JobRunLog[]
  integrationProviders   IntegrationProvider[]
  integrationAuditLogs   IntegrationProviderAuditLog[]
  integrationTemplates   IntegrationTemplate[]
  integrationOutbox      IntegrationOutbox[]
  integrationOAuthTokens IntegrationOAuthToken[]
  integrationOAuthFlows  IntegrationOAuthFlow[]
  integrationOAuthAudits IntegrationOAuthCallbackAudit[]
  webSocketRuntimeEvents IntegrationWebSocketRuntimeEvent[]
  collaborationMessages  CollaborationMessage[]
  collaborationNotices   CollaborationNotice[]
  auditLogs              AuditLog[]
  loginLogs              LoginLog[]
  onlineSessions         OnlineUserSession[]
  createdAt              DateTime                           @default(now())
  updatedAt              DateTime                           @updatedAt

  @@index([planId])
  @@index([status, expiresAt])
}

model TenantMembership {
  id              String                 @id @default(cuid())
  tenantId        String
  tenant          Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId          String
  user            User                   @relation("TenantMembershipUser", fields: [userId], references: [id], onDelete: Cascade)
  status          String                 @default("active")
  isOwner         Boolean                @default(false)
  deptId          String?
  dept            SystemDept?            @relation(fields: [deptId], references: [id], onDelete: SetNull)
  invitedByUserId String?
  invitedBy       User?                  @relation("TenantMembershipInvitedBy", fields: [invitedByUserId], references: [id], onDelete: SetNull)
  joinedAt        DateTime?
  lastActiveAt    DateTime?
  roles           TenantMembershipRole[]
  posts           TenantMembershipPost[]
  onlineSessions  OnlineUserSession[]
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  @@unique([tenantId, userId])
  @@unique([tenantId, id])
  @@index([userId, status])
  @@index([deptId])
  @@index([invitedByUserId])
}

model TenantMembershipRole {
  tenantId     String
  membershipId String
  roleId       String
  tenant       Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  membership   TenantMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  role         Role             @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([tenantId, membershipId, roleId])
  @@index([membershipId])
  @@index([roleId])
}

model TenantMembershipPost {
  tenantId     String
  membershipId String
  postId       String
  tenant       Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  membership   TenantMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  post         SystemPost       @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@id([tenantId, membershipId, postId])
  @@index([membershipId])
  @@index([postId])
}

model PlatformRole {
  id          String                   @id @default(cuid())
  code        String                   @unique
  name        String
  enabled     Boolean                  @default(true)
  system      Boolean                  @default(false)
  users       UserPlatformRole[]
  permissions PlatformRolePermission[]
  createdAt   DateTime                 @default(now())
  updatedAt   DateTime                 @updatedAt
}

model UserPlatformRole {
  userId         String
  platformRoleId String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  platformRole   PlatformRole @relation(fields: [platformRoleId], references: [id], onDelete: Cascade)

  @@id([userId, platformRoleId])
  @@index([platformRoleId])
}

model PlatformRolePermission {
  platformRoleId String
  permissionId   String
  platformRole   PlatformRole @relation(fields: [platformRoleId], references: [id], onDelete: Cascade)
  permission     Permission   @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([platformRoleId, permissionId])
  @@index([permissionId])
}

model Role {
  id                String                 @id @default(cuid())
  tenantId          String                 @default("tenant_root")
  tenant            Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  code              String
  name              String
  enabled           Boolean                @default(true)
  system            Boolean                @default(false)
  dataScope         String                 @default("all")
  dataScopeDeptIds  Json?
  users             UserRole[]
  tenantMemberships TenantMembershipRole[]
  permissions       RolePermission[]
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  @@unique([tenantId, code])
  @@unique([tenantId, id])
  @@index([tenantId])
}

model Permission {
  id            String                   @id @default(cuid())
  code          String                   @unique
  title         String
  roles         RolePermission[]
  platformRoles PlatformRolePermission[]
  menus         Menu[]
  createdAt     DateTime                 @default(now())
  updatedAt     DateTime                 @updatedAt
}

model Menu {
  id           String      @id @default(cuid())
  key          String      @unique
  parentKey    String?
  parent       Menu?       @relation("MenuTree", fields: [parentKey], references: [key], onDelete: SetNull, onUpdate: Cascade)
  children     Menu[]      @relation("MenuTree")
  title        String
  type         String      @default("menu")
  path         String
  icon         String?
  component    String?
  permissionId String?
  permission   Permission? @relation(fields: [permissionId], references: [id])
  order        Int
  status       String      @default("enabled")
  cache        Boolean     @default(false)
  hidden       Boolean     @default(false)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([parentKey, order])
  @@index([status, order])
}

model UserRole {
  userId String
  roleId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

model UserPost {
  userId String
  postId String
  user   User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  post   SystemPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@id([userId, postId])
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model DictType {
  id          String     @id @default(cuid())
  tenantId    String     @default("tenant_root")
  tenant      Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  code        String
  name        String
  description String?
  remark      String?
  enabled     Boolean    @default(true)
  system      Boolean    @default(false)
  items       DictItem[]
  deletedAt   DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@unique([tenantId, code])
  @@unique([tenantId, id])
  @@index([tenantId, enabled, createdAt])
  @@index([tenantId, deletedAt, createdAt])
}

model DictItem {
  id        String    @id @default(cuid())
  typeId    String
  type      DictType  @relation(fields: [typeId], references: [id], onDelete: Restrict)
  label     String
  value     String
  sort      Int       @default(0)
  enabled   Boolean   @default(true)
  colorType String?
  cssClass  String?
  remark    String?
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([typeId, value])
  @@index([typeId, enabled, sort])
  @@index([deletedAt, updatedAt])
}

model SystemConfig {
  id          String                            @id @default(cuid())
  tenantId    String                            @default("tenant_root")
  tenant      Tenant                            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  category    String                            @default("system")
  name        String
  key         String
  value       String
  valueType   String
  description String?
  remark      String?
  public      Boolean                           @default(false)
  system      Boolean                           @default(false)
  overrides   SystemConfigEnvironmentOverride[]
  secrets     SystemConfigSecretVersion[]
  createdAt   DateTime                          @default(now())
  updatedAt   DateTime                          @updatedAt

  @@unique([tenantId, key])
  @@index([tenantId, category, createdAt])
}

model SystemConfigEnvironmentOverride {
  id          String       @id @default(cuid())
  tenantId    String       @default("tenant_root")
  key         String
  environment String
  value       String
  valueType   String
  description String?
  remark      String?
  config      SystemConfig @relation(fields: [tenantId, key], references: [tenantId, key], onDelete: Cascade)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@unique([tenantId, key, environment])
  @@index([tenantId, environment])
}

model SystemConfigSecretVersion {
  id        String       @id @default(cuid())
  tenantId  String       @default("tenant_root")
  key       String
  version   Int
  value     String
  valueType String
  active    Boolean      @default(false)
  rotatedBy String?
  reason    String?
  config    SystemConfig @relation(fields: [tenantId, key], references: [tenantId, key], onDelete: Cascade)
  createdAt DateTime     @default(now())

  @@unique([tenantId, key, version])
  @@index([tenantId, key, active])
  @@index([tenantId, createdAt])
}

model SystemNotice {
  id           String                    @id @default(cuid())
  tenantId     String                    @default("tenant_root")
  tenant       Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  title        String
  content      String
  type         String
  status       String                    @default("draft")
  audience     String                    @default("all")
  pinned       Boolean                   @default(false)
  validFrom    DateTime?
  validTo      DateTime?
  publishedAt  DateTime?
  archivedAt   DateTime?
  createdBy    String
  readReceipts SystemNoticeReadReceipt[]
  deliveries   SystemNoticeDelivery[]
  createdAt    DateTime                  @default(now())
  updatedAt    DateTime                  @updatedAt

  @@unique([tenantId, id])
  @@index([tenantId, status, type])
  @@index([tenantId, audience, pinned])
}

model SystemNoticeTemplate {
  id              String   @id @default(cuid())
  tenantId        String   @default("tenant_root")
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  code            String
  name            String
  type            String
  titleTemplate   String
  contentTemplate String
  params          Json     @default("[]")
  enabled         Boolean  @default(true)
  remark          String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([tenantId, code])
  @@index([tenantId, enabled, type])
}

model SystemNoticeReadReceipt {
  id        String       @id @default(cuid())
  tenantId  String       @default("tenant_root")
  noticeId  String
  userId    String
  tenant    Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  notice    SystemNotice @relation(fields: [tenantId, noticeId], references: [tenantId, id], onDelete: Cascade)
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  readAt    DateTime     @default(now())
  createdAt DateTime     @default(now())

  @@unique([tenantId, noticeId, userId])
  @@index([tenantId, userId, readAt])
  @@index([tenantId, noticeId, readAt])
}

model SystemNoticeDelivery {
  id                String       @id @default(cuid())
  tenantId          String       @default("tenant_root")
  noticeId          String
  userId            String
  username          String
  displayName       String
  channel           String       @default("in_app")
  status            String       @default("delivered")
  provider          String       @default("in_app.local")
  providerStatus    String       @default("pending")
  recipient         String?
  providerMessageId String?
  attemptCount      Int          @default(0)
  title             String
  content           String
  type              String
  audience          String
  deliveredAt       DateTime     @default(now())
  lastAttemptAt     DateTime?
  sentAt            DateTime?
  lastError         String?
  readAt            DateTime?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  tenant            Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  notice            SystemNotice @relation(fields: [tenantId, noticeId], references: [tenantId, id], onDelete: Cascade)
  user              User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, noticeId, userId, channel])
  @@index([tenantId, noticeId, status])
  @@index([tenantId, noticeId, providerStatus])
  @@index([tenantId, userId, status])
  @@index([tenantId, channel, status])
  @@index([tenantId, provider, providerStatus])
  @@index([tenantId, providerMessageId])
}

model SystemDept {
  id                String             @id @default(cuid())
  tenantId          String             @default("tenant_root")
  tenant            Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  code              String
  name              String
  parentId          String?
  parent            SystemDept?        @relation("SystemDeptTree", fields: [parentId], references: [id], onDelete: SetNull)
  children          SystemDept[]       @relation("SystemDeptTree")
  users             User[]
  tenantMemberships TenantMembership[]
  order             Int                @default(0)
  leader            String?
  phone             String?
  email             String?
  enabled           Boolean            @default(true)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@unique([tenantId, code])
  @@unique([tenantId, id])
  @@index([tenantId])
  @@index([tenantId, parentId, order])
  @@index([parentId, order])
}

model SystemPost {
  id                String                 @id @default(cuid())
  tenantId          String                 @default("tenant_root")
  tenant            Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  code              String
  name              String
  order             Int                    @default(0)
  description       String?
  enabled           Boolean                @default(true)
  users             UserPost[]
  tenantMemberships TenantMembershipPost[]
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  @@unique([tenantId, code])
  @@unique([tenantId, id])
  @@index([tenantId])
  @@index([enabled, order])
}

model FileAsset {
  id           String   @id @default(cuid())
  tenantId     String   @default("tenant_root")
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  originalName String
  mimeType     String
  sizeBytes    Int
  storageKey   String
  checksum     String?
  uploadedBy   String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([tenantId, storageKey])
  @@index([tenantId, createdAt])
}

model AuditLog {
  id            String   @id @default(cuid())
  tenantId      String   @default("tenant_root")
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  actorUsername String
  action        String
  resource      String
  resourceId    String?
  method        String
  path          String
  statusCode    Int
  ip            String
  location      String   @default("Unknown")
  userAgent     String
  requestId     String
  durationMs    Int      @default(0)
  metadata      Json?
  createdAt     DateTime @default(now())

  @@index([tenantId, createdAt])
  @@index([tenantId, resource, createdAt])
  @@index([createdAt])
  @@index([resource, createdAt])
  @@index([location])
}

model LoginLog {
  id            String   @id @default(cuid())
  tenantId      String   @default("tenant_root")
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  username      String
  logType       String   @default("login.username")
  result        String   @default("success")
  success       Boolean
  failureReason String?
  actorUsername String?
  reason        String?
  ip            String
  location      String   @default("Unknown")
  userAgent     String
  requestId     String
  createdAt     DateTime @default(now())

  @@index([tenantId, createdAt])
  @@index([tenantId, username, createdAt])
}

model LoginLockout {
  id             String    @id @default(cuid())
  username       String    @unique
  failedAttempts Int       @default(0)
  lockedUntil    DateTime?
  lastFailedAt   DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model CollaborationMessage {
  id           String    @id @default(cuid())
  tenantId     String    @default("tenant_root")
  tenant       Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  title        String
  body         String
  sender       String
  recipient    String
  status       String    @default("unread")
  businessType String?
  businessId   String?
  readAt       DateTime?
  archivedAt   DateTime?
  deletedAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([tenantId, recipient, status, createdAt])
  @@index([tenantId, sender, createdAt])
  @@index([tenantId, businessType, businessId])
  @@index([tenantId, deletedAt])
}

model CollaborationNotice {
  id             String    @id @default(cuid())
  tenantId       String    @default("tenant_root")
  tenant         Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  title          String
  body           String
  status         String    @default("draft")
  targetAudience Json
  validFrom      DateTime?
  validTo        DateTime?
  publishedAt    DateTime?
  archivedAt     DateTime?
  createdBy      String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([tenantId, status, createdAt])
  @@index([tenantId, createdBy, createdAt])
}

model CollaborationTodo {
  id           String    @id @default(cuid())
  title        String
  description  String?
  sourceType   String
  businessType String?
  businessId   String?
  assignee     String
  status       String    @default("pending")
  timeline     Json
  completedAt  DateTime?
  canceledAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([assignee, status, createdAt])
  @@index([sourceType, status])
  @@index([businessType, businessId])
}

model CollaborationApprovalLite {
  id           String    @id @default(cuid())
  title        String
  requester    String
  approver     String
  businessType String?
  businessId   String?
  status       String    @default("pending")
  comment      String?
  timeline     Json
  decidedAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([requester, status, createdAt])
  @@index([approver, status, createdAt])
  @@index([businessType, businessId])
}

model JobDefinition {
  id             String      @id @default(cuid())
  tenantId       String      @default("tenant_root")
  tenant         Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  code           String
  name           String
  queueName      String
  cron           String?
  enabled        Boolean     @default(true)
  retryLimit     Int         @default(3)
  timeoutSeconds Int         @default(60)
  payload        Json?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  runs           JobRunLog[]

  @@unique([tenantId, code])
  @@index([tenantId, queueName, enabled])
}

model JobRunLog {
  id         String        @id @default(cuid())
  tenantId   String        @default("tenant_root")
  tenant     Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  jobCode    String
  job        JobDefinition @relation(fields: [tenantId, jobCode], references: [tenantId, code], onDelete: Cascade)
  status     String
  trigger    String
  attempts   Int           @default(1)
  durationMs Int?
  startedAt  DateTime      @default(now())
  finishedAt DateTime?
  error      String?
  metadata   Json?

  @@index([tenantId, status, startedAt])
  @@index([tenantId, jobCode, status])
}

model OnlineUserSession {
  id            String            @id @default(cuid())
  username      String
  tokenId       String            @unique
  tenantId      String?
  tenant        Tenant?           @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  membershipId  String?
  membership    TenantMembership? @relation(fields: [membershipId], references: [id], onDelete: SetNull)
  accessMode    String            @default("tenant")
  ip            String
  userAgent     String
  lastSeenAt    DateTime
  expiresAt     DateTime
  revokedAt     DateTime?
  revokedBy     String?
  revokedReason String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@index([tenantId])
  @@index([membershipId])
}

model ReportDefinition {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  description String?
  querySchema Json
  enabled     Boolean  @default(true)
  owner       String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model IntegrationProvider {
  id              String    @id @default(cuid())
  tenantId        String    @default("tenant_root")
  tenant          Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  code            String
  type            String
  name            String
  enabled         Boolean   @default(false)
  secretRef       String
  secretRefStatus String    @default("unchecked")
  config          Json
  configVersion   Int       @default(1)
  healthStatus    String    @default("unknown")
  lastCheckedAt   DateTime?
  lastTestStatus  String?
  lastTestMessage String?
  lastTestedAt    DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([tenantId, code])
  @@index([tenantId, type, code])
  @@index([tenantId, healthStatus])
}

model IntegrationProviderAuditLog {
  id                    String   @id @default(cuid())
  tenantId              String   @default("tenant_root")
  tenant                Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  providerCode          String
  action                String
  actor                 String   @default("admin")
  reason                String?
  beforeConfigVersion   Int?
  afterConfigVersion    Int?
  beforeSecretRefStatus String?
  afterSecretRefStatus  String?
  testStatus            String?
  message               String?
  summary               Json?
  createdAt             DateTime @default(now())

  @@index([tenantId, providerCode, createdAt])
  @@index([tenantId, action])
}

model IntegrationTemplate {
  id        String   @id @default(cuid())
  tenantId  String   @default("tenant_root")
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  code      String
  channel   String
  name      String
  subject   String?
  body      String
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, code])
  @@index([tenantId, channel, code])
}

model IntegrationOutbox {
  id           String    @id @default(cuid())
  tenantId     String    @default("tenant_root")
  tenant       Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  channel      String
  providerCode String
  templateCode String?
  recipient    String
  subject      String?
  payload      Json
  attachments  Json?
  status       String    @default("queued")
  retryCount   Int       @default(0)
  preview      String?
  error        String?
  sentAt       DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([tenantId, channel, status])
  @@index([tenantId, providerCode, status])
}

model IntegrationOAuthToken {
  id                String    @id @default(cuid())
  tenantId          String    @default("tenant_root")
  tenant            Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  providerCode      String
  subjectType       String
  subjectId         String
  providerAccountId String
  scopes            Json
  accessTokenRef    String
  refreshTokenRef   String?
  status            String    @default("active")
  expiresAt         DateTime?
  lastRotatedAt     DateTime?
  revokedAt         DateTime?
  revokedBy         String?
  revokeReason      String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@unique([tenantId, providerCode, subjectId, providerAccountId])
  @@index([tenantId, providerCode])
  @@index([tenantId, status])
  @@index([tenantId, subjectType, subjectId])
}

model IntegrationOAuthFlow {
  id               String    @id @default(cuid())
  tenantId         String    @default("tenant_root")
  tenant           Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  providerCode     String
  state            String    @unique
  subjectType      String
  subjectId        String
  scopes           Json
  redirectUri      String?
  authorizationUrl String
  status           String    @default("pending")
  expiresAt        DateTime
  callbackCodeHash String?
  callbackError    String?
  tokenId          String?
  completedAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([tenantId, providerCode, status])
  @@index([tenantId, subjectId, createdAt])
}

model IntegrationOAuthCallbackAudit {
  id                String   @id @default(cuid())
  tenantId          String   @default("tenant_root")
  tenant            Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  providerCode      String
  flowId            String?
  state             String
  status            String
  reason            String?
  callbackCodeHash  String?
  callbackError     String?
  providerAccountId String?
  tokenId           String?
  createdAt         DateTime @default(now())

  @@index([tenantId, providerCode, createdAt])
  @@index([tenantId, state])
  @@index([tenantId, status])
}

model IntegrationWebSocketRuntimeEvent {
  id             String   @id
  tenantId       String   @default("tenant_root")
  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  room           String
  type           String
  payloadPreview Json
  traceId        String?
  deliveredCount Int
  status         String
  createdAt      DateTime @default(now())

  @@index([tenantId, room, createdAt])
  @@index([tenantId, type, createdAt])
  @@index([traceId])
  @@index([tenantId, createdAt])
}

model AreaDatasetVersion {
  id         String        @id @default(cuid())
  version    String        @unique
  source     String
  checksum   String
  importedAt DateTime
  active     Boolean       @default(false)
  regions    AreaRegion[]
  ipRanges   AreaIpRange[]
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  @@index([active, importedAt])
  @@index([importedAt])
}

model AreaRegion {
  id             String             @id @default(cuid())
  datasetVersion String
  dataset        AreaDatasetVersion @relation(fields: [datasetVersion], references: [version], onDelete: Cascade)
  code           String
  name           String
  parentCode     String?
  level          Int
  path           Json
  aliases        Json
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@unique([datasetVersion, code])
  @@index([datasetVersion, parentCode])
  @@index([datasetVersion, level])
}

model AreaIpRange {
  id             String             @id @default(cuid())
  datasetVersion String
  dataset        AreaDatasetVersion @relation(fields: [datasetVersion], references: [version], onDelete: Cascade)
  regionCode     String
  cidr           String
  start          BigInt
  end            BigInt
  startIp        String
  endIp          String
  createdAt      DateTime           @default(now())

  @@index([datasetVersion, regionCode])
  @@index([datasetVersion, start, end])
}
