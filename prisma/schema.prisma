generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id               String                    @id @default(cuid())
  username         String                    @unique
  displayName      String
  passwordHash     String
  enabled          Boolean                   @default(true)
  avatarUrl        String?
  avatarStorageKey String?                   @unique
  avatarMimeType   String?
  avatarSizeBytes  Int?
  avatarUpdatedAt  DateTime?
  deptId           String?
  dept             SystemDept?               @relation(fields: [deptId], references: [id], onDelete: SetNull)
  roles            UserRole[]
  posts            UserPost[]
  noticeReads      SystemNoticeReadReceipt[]
  noticeDeliveries SystemNoticeDelivery[]
  createdAt        DateTime                  @default(now())
  updatedAt        DateTime                  @updatedAt

  @@index([deptId])
}

model Role {
  id               String           @id @default(cuid())
  code             String           @unique
  name             String
  enabled          Boolean          @default(true)
  system           Boolean          @default(false)
  dataScope        String           @default("all")
  dataScopeDeptIds Json?
  users            UserRole[]
  permissions      RolePermission[]
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
}

model Permission {
  id        String           @id @default(cuid())
  code      String           @unique
  title     String
  roles     RolePermission[]
  menus     Menu[]
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
}

model Menu {
  id           String      @id @default(cuid())
  key          String      @unique
  parentKey    String?
  parent       Menu?       @relation("MenuTree", fields: [parentKey], references: [key], onDelete: SetNull, onUpdate: Cascade)
  children     Menu[]      @relation("MenuTree")
  title        String
  type         String      @default("menu")
  path         String
  icon         String?
  component    String?
  permissionId String?
  permission   Permission? @relation(fields: [permissionId], references: [id])
  order        Int
  status       String      @default("enabled")
  cache        Boolean     @default(false)
  hidden       Boolean     @default(false)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([parentKey, order])
  @@index([status, order])
}

model UserRole {
  userId String
  roleId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

model UserPost {
  userId String
  postId String
  user   User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  post   SystemPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@id([userId, postId])
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model DictType {
  id          String     @id @default(cuid())
  code        String     @unique
  name        String
  description String?
  enabled     Boolean    @default(true)
  items       DictItem[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model DictItem {
  id        String   @id @default(cuid())
  typeId    String
  type      DictType @relation(fields: [typeId], references: [id], onDelete: Cascade)
  label     String
  value     String
  sort      Int      @default(0)
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([typeId, value])
}

model SystemConfig {
  id          String   @id @default(cuid())
  category    String   @default("system")
  name        String
  key         String   @unique
  value       String
  valueType   String
  description String?
  remark      String?
  public      Boolean  @default(false)
  system      Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model SystemNotice {
  id           String                    @id @default(cuid())
  title        String
  content      String
  type         String
  status       String                    @default("draft")
  audience     String                    @default("all")
  pinned       Boolean                   @default(false)
  validFrom    DateTime?
  validTo      DateTime?
  publishedAt  DateTime?
  archivedAt   DateTime?
  createdBy    String
  readReceipts SystemNoticeReadReceipt[]
  deliveries   SystemNoticeDelivery[]
  createdAt    DateTime                  @default(now())
  updatedAt    DateTime                  @updatedAt

  @@index([status, type])
  @@index([audience, pinned])
}

model SystemNoticeTemplate {
  id              String   @id @default(cuid())
  code            String   @unique
  name            String
  type            String
  titleTemplate   String
  contentTemplate String
  params          Json     @default("[]")
  enabled         Boolean  @default(true)
  remark          String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([enabled, type])
}

model SystemNoticeReadReceipt {
  id        String       @id @default(cuid())
  noticeId  String
  userId    String
  notice    SystemNotice @relation(fields: [noticeId], references: [id], onDelete: Cascade)
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  readAt    DateTime     @default(now())
  createdAt DateTime     @default(now())

  @@unique([noticeId, userId])
  @@index([userId, readAt])
  @@index([noticeId, readAt])
}

model SystemNoticeDelivery {
  id          String       @id @default(cuid())
  noticeId    String
  userId      String
  username    String
  displayName String
  channel     String       @default("in_app")
  status      String       @default("delivered")
  title       String
  content     String
  type        String
  audience    String
  deliveredAt DateTime     @default(now())
  readAt      DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  notice      SystemNotice @relation(fields: [noticeId], references: [id], onDelete: Cascade)
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([noticeId, userId, channel])
  @@index([noticeId, status])
  @@index([userId, status])
  @@index([channel, status])
}

model SystemDept {
  id        String       @id @default(cuid())
  code      String       @unique
  name      String
  parentId  String?
  parent    SystemDept?  @relation("SystemDeptTree", fields: [parentId], references: [id], onDelete: SetNull)
  children  SystemDept[] @relation("SystemDeptTree")
  users     User[]
  order     Int          @default(0)
  leader    String?
  phone     String?
  email     String?
  enabled   Boolean      @default(true)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@index([parentId, order])
}

model SystemPost {
  id          String     @id @default(cuid())
  code        String     @unique
  name        String
  order       Int        @default(0)
  description String?
  enabled     Boolean    @default(true)
  users       UserPost[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([enabled, order])
}

model FileAsset {
  id           String   @id @default(cuid())
  originalName String
  mimeType     String
  sizeBytes    Int
  storageKey   String   @unique
  checksum     String?
  uploadedBy   String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model AuditLog {
  id            String   @id @default(cuid())
  actorUsername String
  action        String
  resource      String
  resourceId    String?
  method        String
  path          String
  statusCode    Int
  ip            String
  userAgent     String
  requestId     String
  metadata      Json?
  createdAt     DateTime @default(now())
}

model LoginLog {
  id            String   @id @default(cuid())
  username      String
  logType       String   @default("login.username")
  result        String   @default("success")
  success       Boolean
  failureReason String?
  actorUsername String?
  reason        String?
  ip            String
  location      String   @default("Unknown")
  userAgent     String
  requestId     String
  createdAt     DateTime @default(now())
}

model LoginLockout {
  id             String    @id @default(cuid())
  username       String    @unique
  failedAttempts Int       @default(0)
  lockedUntil    DateTime?
  lastFailedAt   DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model CollaborationMessage {
  id           String    @id @default(cuid())
  title        String
  body         String
  sender       String
  recipient    String
  status       String    @default("unread")
  businessType String?
  businessId   String?
  readAt       DateTime?
  archivedAt   DateTime?
  deletedAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model CollaborationNotice {
  id             String    @id @default(cuid())
  title          String
  body           String
  status         String    @default("draft")
  targetAudience Json
  validFrom      DateTime?
  validTo        DateTime?
  publishedAt    DateTime?
  archivedAt     DateTime?
  createdBy      String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model CollaborationTodo {
  id           String    @id @default(cuid())
  title        String
  description  String?
  sourceType   String
  businessType String?
  businessId   String?
  assignee     String
  status       String    @default("pending")
  timeline     Json
  completedAt  DateTime?
  canceledAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model CollaborationApprovalLite {
  id           String    @id @default(cuid())
  title        String
  requester    String
  approver     String
  businessType String?
  businessId   String?
  status       String    @default("pending")
  comment      String?
  timeline     Json
  decidedAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model JobDefinition {
  id             String      @id @default(cuid())
  code           String      @unique
  name           String
  queueName      String
  cron           String?
  enabled        Boolean     @default(true)
  retryLimit     Int         @default(3)
  timeoutSeconds Int         @default(60)
  payload        Json?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  runs           JobRunLog[]
}

model JobRunLog {
  id         String        @id @default(cuid())
  jobCode    String
  job        JobDefinition @relation(fields: [jobCode], references: [code], onDelete: Cascade)
  status     String
  trigger    String
  attempts   Int           @default(1)
  startedAt  DateTime      @default(now())
  finishedAt DateTime?
  error      String?
  metadata   Json?
}

model OnlineUserSession {
  id            String    @id @default(cuid())
  username      String
  tokenId       String    @unique
  ip            String
  userAgent     String
  lastSeenAt    DateTime
  expiresAt     DateTime
  revokedAt     DateTime?
  revokedBy     String?
  revokedReason String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model ReportDefinition {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  description String?
  querySchema Json
  enabled     Boolean  @default(true)
  owner       String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model IntegrationProvider {
  id            String    @id @default(cuid())
  code          String    @unique
  type          String
  name          String
  enabled       Boolean   @default(false)
  secretRef     String
  config        Json
  healthStatus  String    @default("unknown")
  lastCheckedAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model IntegrationTemplate {
  id        String   @id @default(cuid())
  code      String   @unique
  channel   String
  name      String
  subject   String?
  body      String
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model IntegrationOutbox {
  id           String    @id @default(cuid())
  channel      String
  providerCode String
  templateCode String?
  recipient    String
  payload      Json
  status       String    @default("queued")
  retryCount   Int       @default(0)
  preview      String?
  error        String?
  sentAt       DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}
