{
  "name": "@opencore/admin",
  "version": "6.0.2",
  "private": true,
  "description": "OpenCore Admin console",
  "repository": "https://github.com/Gan-Xing/OpenCore.git",
  "scripts": {
    "analyze": "cross-env ANALYZE=1 max build",
    "build": "cross-env FORCE_UTOOPACK= OPENCORE_ADMIN_BUNDLER=webpack max build",
    "dev": "cross-env UMI_ENV=dev max dev",
    "lint": "pnpm biome:lint && pnpm exec max setup && pnpm tsc",
    "biome:lint": "biome lint",
    "biome": "biome check --write",
    "openapi": "pnpm --dir ../.. openapi:export && pnpm --dir ../.. sdk:check",
    "preview": "max preview --port 8000",
    "preview:build": "cross-env FORCE_UTOOPACK= OPENCORE_ADMIN_BUNDLER=webpack max build && max preview --port 8000",
    "record": "cross-env NODE_ENV=development UMI_ENV=test max record --scene=login",
    "start": "cross-env UMI_ENV=dev max dev",
    "start:no-mock": "cross-env MOCK=none max dev",
    "start:pre": "cross-env UMI_ENV=pre MOCK=none max dev",
    "start:test": "cross-env UMI_ENV=test MOCK=none max dev",
    "test": "TS_NODE_PROJECT=../../tools/scripts/tsconfig.json TS_NODE_COMPILER_OPTIONS='{\"moduleResolution\":\"node10\",\"module\":\"commonjs\",\"customConditions\":null}' node -r ts-node/register -r tsconfig-paths/register scripts/smoke-test.ts && vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "doctor": "react-doctor .",
    "tsc": "tsc --noEmit"
  },
  "browserslist": [
    "defaults"
  ],
  "dependencies": {
    "@ant-design/icons": "^6.2.3",
    "@ant-design/plots": "^2.6.8",
    "@ant-design/pro-components": "^3.1.12-0",
    "@ant-design/x": "^2.8.0",
    "@ant-design/x-markdown": "^2.8.0",
    "@ant-design/x-sdk": "^2.8.0",
    "@opencore/module-registry": "workspace:*",
    "@opencore/sdk": "workspace:*",
    "@rc-component/util": "^1.11.0",
    "@tanstack/react-query": "^5.101.0",
    "antd": "^6.4.3",
    "antd-style": "^4.1.0",
    "clsx": "^2.1.1",
    "d3": "^7.9.0",
    "dayjs": "^1.11.20",
    "highlight.js": "^11.11.1",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "topojson-client": "^3.1.0"
  },
  "devDependencies": {
    "@ant-design/cli": "^6.4.3",
    "@biomejs/biome": "^2.4.16",
    "@commitlint/cli": "^21.0.0",
    "@commitlint/config-conventional": "^21.0.0",
    "@tailwindcss/postcss": "^4.3.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/d3": "^7.4.3",
    "@types/express": "^5.0.6",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/react-helmet": "^6.1.11",
    "@types/topojson-client": "^3.1.5",
    "@types/topojson-specification": "^1.0.5",
    "@umijs/lint": "^4.6.51",
    "@umijs/max": "^4.6.57",
    "@umijs/request-record": "^1.1.4",
    "@vitest/coverage-v8": "4.1.8",
    "@vitest/ui": "4.1.8",
    "cross-env": "^10.1.0",
    "express": "^5.2.1",
    "geojson": "^0.5.0",
    "happy-dom": "^20.10.1",
    "jsdom": "^29.1.1",
    "lint-staged": "^17.0.2",
    "react-doctor": "^0.5.0",
    "swagger-ui-dist": "^5.32.5",
    "tailwindcss": "^4.3.0",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "vitest": "4.1.8"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
