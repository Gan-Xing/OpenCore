  "docs": {
    "moduleDoc": "docs/generated/openforge/core.dict.md",
    "runbook": "docs/generated/openforge/core.dict-runbook.md",
    "patchReview": "docs/generated/openforge/core.dict-patch-review.md"
  },
  "export": {
