{
  "schemaVersion": "openforge.schema.v1",
  "moduleCode": "core.dict",
  "resource": "dict",
  "title": "Dictionaries",
  "description": "Dictionary type and item management V1 schema.",
  "fields": [
    {
      "name": "code",
      "title": "Code",
      "type": "string",
      "required": true,
      "list": true,
      "form": true,
      "detail": true
    },
    {
      "name": "name",
      "title": "Name",
      "type": "string",
      "required": true,
      "list": true,
      "form": true,
      "detail": true
    },
    {
      "name": "description",
      "title": "Description",
      "type": "text",
      "form": true,
      "detail": true
    },
    {
      "name": "enabled",
      "title": "Enabled",
      "type": "boolean",
      "list": true,
      "form": true,
      "detail": true
    },
    {
      "name": "sort",
      "title": "Sort",
      "type": "number",
      "list": true,
      "form": true,
      "detail": true
    },
    {
      "name": "status",
      "title": "Status",
      "type": "enum",
      "enumValues": ["enabled", "disabled"],
      "list": true,
      "form": true,
      "detail": true
    },
    {
      "name": "metadata",
      "title": "Metadata",
      "type": "json",
      "detail": true
    },
    {
      "name": "ownerId",
      "title": "Owner",
      "type": "relation",
      "relation": {
        "targetModule": "core.user",
        "targetResource": "user",
        "cardinality": "one",
        "displayField": "username"
      },
      "detail": true
    },
    {
      "name": "icon",
      "title": "Icon",
      "type": "file",
      "fileAccept": ["image/png", "image/svg+xml"],
      "form": true,
      "detail": true
    },
    {
      "name": "createdAt",
      "title": "Created At",
      "type": "datetime",
      "list": true,
      "detail": true
    }
  ],
  "relations": [
    {
      "targetModule": "core.user",
      "targetResource": "user",
      "cardinality": "one",
      "displayField": "username"
    }
  ],
  "indexes": [
    {
      "name": "dict_code_unique",
      "fields": ["code"],
      "unique": true,
      "reason": "Dictionary code must be stable and unique."
    },
    {
      "name": "dict_enabled_sort",
      "fields": ["enabled", "sort"],
      "reason": "Admin list defaults to enabled/sort ordering."
    }
  ],
  "list": {
    "title": "Dictionaries",
    "columns": ["code", "name", "enabled", "sort", "createdAt"],
    "defaultPageSize": 10
  },
  "filter": {
    "fields": ["code", "name", "enabled", "status"]
  },
  "sort": {
    "default": {
      "field": "sort",
      "direction": "asc"
    },
    "fields": ["sort", "createdAt"]
  },
  "form": {
    "title": "Dictionary",
    "mode": "modal",
    "fields": [
      "code",
      "name",
      "description",
      "enabled",
      "sort",
      "status",
      "icon"
    ]
  },
  "detail": {
    "title": "Dictionary Details",
    "fields": [
      "code",
      "name",
      "description",
      "enabled",
      "sort",
      "status",
      "metadata",
      "ownerId",
      "icon",
      "createdAt"
    ]
  },
  "actions": ["read", "create", "update", "delete", "export"],
  "permissions": [
    "core:dict:read",
    "core:dict:create",
    "core:dict:update",
    "core:dict:delete",
    "core:dict:export"
  ],
  "openapi": {
    "tags": ["Core Dictionaries"],
    "paths": [
      "/api/core/dicts",
      "/api/core/dicts/export",
      "/api/core/dicts/{code}"
