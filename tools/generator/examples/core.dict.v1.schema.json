      "packages/sdk/src/generated/dict-client.spec.ts"
    ]
  },
  "tests": {
    "api": "apps/api/src/modules/generated/core/dict/dict.spec.ts",
    "admin": "apps/admin/src/pages/Generated/Dict/Dict.smoke.spec.ts",
    "e2e": "tools/generator/e2e/generated-module.e2e.spec.ts"
